# =============================================================
# Lista de Presentes · Gabriely & Gustavo — variáveis de ambiente
# Copie p/ .env.local em dev. Em Vercel: Settings → Environment Variables.
# =============================================================

# --- Mercado Pago (C7b) ---
# Production: pegue em https://www.mercadopago.com.br/developers → suas credenciais.
# Sandbox: use credenciais de teste durante dev.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Configurar webhook no MP dashboard apontando p/ https://<sua-url>/api/mp/webhook
# MP gera esse secret no painel de webhooks — V12 valida x-signature com ele
MP_WEBHOOK_SECRET=

# --- Airtable (C7a) ---
# 1. Criar base manualmente em https://airtable.com
# 2. Personal Access Token em https://airtable.com/create/tokens
#    Scopes: data.records:read/write + schema.bases:read/write
#    Restringir o token à base criada
# 3. Rodar `npm run airtable:bootstrap` p/ criar tabelas + seed
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Admin (C9) — credenciais do casal ---
# Gere o hash: node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('SUA_SENHA')).then(b=>console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')))"
ADMIN_USER=
ADMIN_PASS_HASH=

# --- Sessão (HMAC dos cookies) ---
# Mínimo 16 chars. Gere com: openssl rand -hex 32
SESSION_SECRET=
